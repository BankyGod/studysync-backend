PORT=3000
JWT_SECRET=change-me-in-production
MONGODB_URI=mongodb://127.0.0.1:27017/studysync
# Comma-separated list for multiple frontends (student app + admin subdomain)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Public API base URL for absolute avatar links (required when frontend is on another host)
PUBLIC_API_URL=http://localhost:3000
# Optional: auto-create/promote admin on startup
# ADMIN_EMAIL=admin@studysync.com
# ADMIN_PASSWORD=SecurePass1
# ADMIN_NAME=System Admin

# LiveKit (preferred in-app video — Cloud or self-hosted)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=secretxxxxxxxx

# Optional legacy: Jitsi / 8x8 JaaS
# JITSI_DOMAIN=8x8.vc
# JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxx
# JAAS_API_KEY_ID=your-api-key-id
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

UPLOADS_DIR=./uploads
