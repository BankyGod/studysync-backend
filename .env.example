PORT=3000
JWT_SECRET=change-me-in-production
MONGODB_URI=mongodb://127.0.0.1:27017/studysync
# Comma-separated list for multiple frontends (student app + admin subdomain)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Public API base URL for absolute avatar links (required when frontend is on another host)
PUBLIC_API_URL=http://localhost:3000
# Jitsi domain for pod video calls (public meet.jit.si needs no API key)
JITSI_DOMAIN=meet.jit.si
UPLOADS_DIR=./uploads
