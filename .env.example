PORT=3000
JWT_SECRET=change-me-in-production
MONGODB_URI=mongodb://127.0.0.1:27017/studysync
# Comma-separated list for multiple frontends (student app + admin subdomain)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Public API base URL for absolute avatar links (required when frontend is on another host)
PUBLIC_API_URL=http://localhost:3000
# Optional: auto-create/promote admin on startup
# ADMIN_EMAIL=admin@studysync.com
# ADMIN_PASSWORD=SecurePass1
# ADMIN_NAME=System Admin
JITSI_DOMAIN=meet.jit.si
# Optional WebRTC ICE servers JSON (defaults to Google public STUN)
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
UPLOADS_DIR=./uploads
